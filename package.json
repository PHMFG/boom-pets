{
  "name": "boom-pets",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "concurrently -k -n relay,web -c magenta,cyan \"pnpm --filter @boom/relay dev\" \"pnpm --filter @boom/web dev\"",
    "build": "pnpm --filter @boom/web build && node tools/check-bundle.ts",
    "start": "concurrently -k -n relay,web -c magenta,cyan \"pnpm --filter @boom/relay start\" \"pnpm --filter @boom/web preview\"",
    "play": "pnpm build && pnpm start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "inspect:pets": "node tools/inspect-glb.ts \"assets-raw/cube-pets/Models/GLB format\"",
    "assets": "node tools/sync-assets.ts",
    "font": "node tools/font.ts",
    "fake": "node tools/fake-phones.ts",
    "sounds": "node tools/sounds.ts",
    "voice": "node tools/voice.ts",
    "balance": "pnpm --filter @boom/relay exec tsx ../../tools/balance.ts",
    "test:e2e": "playwright test",
    "report": "node tools/playtest-report.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
